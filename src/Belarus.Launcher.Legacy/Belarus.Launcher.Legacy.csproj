<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.19041</TargetFramework>
        <OutputType>WinExe</OutputType>
        <UseWPF>true</UseWPF>

        <ApplicationIcon>Assets\Icons\icon_app.ico</ApplicationIcon>

        <AssemblyName>SBLauncher.Wpf</AssemblyName>
        <Company>СhoiceTeam</Company>
        <Authors>Drombeys</Authors>

        <PublishSingleFile>true</PublishSingleFile>

        <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <ItemGroup>
        <Resource Include="Assets\Fonts\*.ttf" />
        <Resource Include="Assets\Icons\*.png" />
        <Resource Include="Assets\Images\*.png" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
        <PackageReference Include="ReactiveUI.SourceGenerators" Version="4.2.0" PrivateAssets="all" />
        <PackageReference Include="ReactiveUI.WPF" Version="26.0.1" />
        <PackageReference Include="Splat.Microsoft.Extensions.DependencyInjection" Version="19.3.1" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="ReactiveUI" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Belarus.Launcher.Core\Belarus.Launcher.Core.csproj" />
    </ItemGroup>
</Project>
