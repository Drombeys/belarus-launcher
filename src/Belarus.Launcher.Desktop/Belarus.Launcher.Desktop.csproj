<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>WinExe</OutputType>

        <InvariantGlobalization>false</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
        <TrimmableAssembly Include="Belarus.Launcher.Themes.Avalonia" />
        <TrimmerRootDescriptor Include="TrimmerRoots.xml" />
    </ItemGroup>

    <PropertyGroup>
        <ApplicationIcon>..\Belarus.Launcher\Assets\Icons\stalker_cs.ico</ApplicationIcon>
        <AssemblyName>SBLauncher</AssemblyName>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <PublishAot>true</PublishAot>
        <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="ReactiveUI.Avalonia" />
        <PackageReference Include="ReactiveUI.SourceGenerators" PrivateAssets="all" />
        <PackageReference Include="ReactiveUI.Validation" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Belarus.Launcher\Belarus.Launcher.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="ReactiveUI" />
        <Using Include="ReactiveUI.Primitives" />
    </ItemGroup>
</Project>
