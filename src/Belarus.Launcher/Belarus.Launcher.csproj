<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Library</OutputType>

        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <UserSecretsId>604bcea0-0583-4597-9afc-fbf849a6fb90</UserSecretsId>
  </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" />
        <PackageReference Include="Avalonia.Fonts.Inter" />
        <PackageReference Include="Avalonia.Themes.Fluent" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Microsoft.Extensions.Http" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
        <PackageReference Include="ReactiveUI.Avalonia" />
        <PackageReference Include="ReactiveUI.SourceGenerators" PrivateAssets="all" />
        <PackageReference Include="ReactiveUI.Validation" />
        <PackageReference Include="Serilog.Extensions.Logging" />
        <PackageReference Include="Serilog.Sinks.Debug" />
        <PackageReference Include="Serilog.Sinks.File" />
        <PackageReference Include="Microsoft.Extensions.Configuration" />
        <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Belarus.Launcher.Core\Belarus.Launcher.Core.csproj" />
        <ProjectReference Include="..\Belarus.Launcher.Themes.Avalonia\Belarus.Launcher.Themes.Avalonia.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="ReactiveUI" />
        <Using Include="ReactiveUI.Primitives" />
        <Using Include="ReactiveUI.Validation.Extensions" />
        <Using Include="ReactiveUI.Validation.Helpers" />
    </ItemGroup>
</Project>
